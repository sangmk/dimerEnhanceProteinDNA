# two proteins discover between two segments

start parameters
    nItr = 1e9 #iterations
    timeStep = 1 # us, the maximum timestep calculated from kbPN
    timeWrite = 1e6
    pdbWrite = 1e4
    trajWrite = 1e4
    restartWrite = 1e7
    checkPoint = 1e7
    assocdissocwrite = true
    overlapSepLimit = 1.0
end parameters

start boundaries
    WaterBox = [1050.0, 31.623, 31.623] # VtoL=4000
end boundaries

start molecules
    P : 20
    N : 600
end molecules

start reactions

    N(bs) + P(dbn) <-> N(bs!1).P(dbn!1)
    onRate3Dka = 0.00020000212208842396
    offRatekb = 1.204412779216489 # Keq = 10^2.0
    norm1 = [0, 0, 1]
    norm2 = [0, 0, 1]
    sigma = 1.00
    assocAngles = [1.916230, 1.129689, 2.717872, -0.091124, 2.394677]
    loopcoopfactor = 1
    bindRadSameCom = 1.1
    area3dto1d = 10

    P(dmr) + P(dmr) <-> P(dmr!1).P(dmr!1)
    onRate3Dka = 0.0006642370041294472 
    offRatekb = 0.4000035238867531 # Keq = 10^3.0
    norm1 = [0, 0, 1]
    norm2 = [0, 0, 1]
    sigma = 2.00
    assocAngles = [1.570796, 1.570796, -1.570796, 1.570796, 0.000000]
    loopcoopfactor = 1
    bindRadSameCom = 10
    area3dto1d = 10

    P(ref) + P(ref) -> P(ref!1).P(ref!1)
    onRate3Dka = 0.0 
    norm1 = [0, 0, 1]
    norm2 = [0, 0, 1]
    sigma = 2.00
    assocAngles = [1.570796, 1.570796, -1.570796, 1.570796, 0.000000]
    loopcoopfactor = 1
    bindRadSameCom = 2
    area3dto1d = 10

end reactions
