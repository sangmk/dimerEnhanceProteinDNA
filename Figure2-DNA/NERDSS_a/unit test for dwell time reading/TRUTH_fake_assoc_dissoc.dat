ITR:108,BREAK,N,40,0,P,1,0
# PPN->PNPN
ITR:120,BOND,N,40,0,P,1,0
# another protein dissociate PNPN->PPN
ITR:122,BREAK,N,100,0,P,0,0
# PPN->PP, tau=130-101=29
ITR:130,BREAK,N,40,0,P,1,0

# fourth PP->PPN
