# two proteins bind nonspecific sites

start parameters
    nItr = 1e9 #iterations
    timeStep = 1 # us, the maximum timestep calculated from kbPN
    timeWrite = 1e8
    pdbWrite = 1e9
    trajWrite = 1e9
    restartWrite = 1e9
    checkPoint = 1e9
    assocdissocwrite = true
    overlapSepLimit = 1.0
end parameters

start boundaries
    WaterBox = [420.0, 31.623, 31.623] # VtoL=4000
end boundaries

start molecules
    P : 2
    N : 240
end molecules

start reactions

    N(bs) + P(dbn) <-> N(bs!1).P(dbn!1)
    onRate3Dka = 0.000200
    offRatekb = 0.6022 # Keq = 10^2.0 M^-1
    norm1 = [0, 0, 1]
    norm2 = [0, 0, 1]
    sigma = 1.00
    assocAngles = [1.289349, 2.579046, 0.000000, nan, M_PI]
    loopcoopfactor = 1
    bindRadSameCom = 1.1
    area3dto1d = 114

    P(dmr) + P(dmr) -> P(dmr!1).P(dmr!1)
    onRate3Dka = 11.5291
    norm1 = [0, 0, 1]
    norm2 = [0, 0, 1]
    sigma = 2.00
    assocAngles = [1.570796, 1.570796, -1.570796, 1.570796, 0.000000]
    loopcoopfactor = 1
    bindRadSameCom = 10
    area3dto1d = 114

end reactions
